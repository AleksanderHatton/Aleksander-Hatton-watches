# Frontend-safe Supabase values. These are allowed to be visible in browser code.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only Supabase value. Never put this in frontend code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Aleksander Hatton <onboarding@resend.dev>"
ADMIN_EMAIL=YOUR_ADMIN_EMAIL

# Your live website URL. Example: https://aleksanderhatton.co.uk
SITE_URL=http://localhost:8888

# eBay selling — server-only; never prefix these values with VITE_.
# Reuse your Production App ID and Cert ID, plus a seller OAuth RuName.
# Set SITE_URL=https://www.ahwatches.com in the live Netlify environment.
EBAY_ENVIRONMENT=production
EBAY_CLIENT_ID=YOUR_EBAY_APP_ID
EBAY_CLIENT_SECRET=YOUR_EBAY_CERT_ID
EBAY_RUNAME=YOUR_EBAY_OAUTH_RUNAME
# Generate once: openssl rand -hex 32. Keep it backed up privately.
# Changing this key requires reconnecting the seller account.
EBAY_TOKEN_ENCRYPTION_KEY=YOUR_64_CHARACTER_HEX_KEY
